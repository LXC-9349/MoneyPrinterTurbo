# MoneyPrinterTurbo biography fork — environment template
# Copy to .env and fill in what you need. Every variable here is OPTIONAL:
# the fork works with only the keys you already use upstream, and each
# historical-archive API degrades gracefully when it is unreachable.

# =============================================================================
# LLM (script generation, term generation, batch annotation)
# =============================================================================
# Any provider id supported by app/models/llm_provider.py (moonshot, openai,
# deepseek, groq, qwen, gemini, volcengine, oneapi, ollama, ...).
MPT_LLM_PROVIDER=moonshot
# Get a key at https://platform.moonshot.cn/console/api-keys (China)
# or https://platform.moonshot.ai/console/api-keys (global)
MOONSHOT_API_KEY=

# Free / keyless options for local testing:
#   MPT_LLM_PROVIDER=ollama            (local models, no key, base_url auto)
#   MPT_LLM_PROVIDER=oneapi            (self-hosted OneAPI/NewAPI gateway)
ONEAPI_API_KEY=
ONEAPI_BASE_URL=

# =============================================================================
# Material sources
# =============================================================================
# Pexels — used as b-roll fallback for biography videos and as a stock source.
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay — alternative stock source. https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Coverr — free HD/4K stock video. https://coverr.co/developers
COVERR_API_KEY=

# =============================================================================
# Network proxy (optional)
# =============================================================================
# Requests for Wikimedia/Wikipedia/LOC/Pexels/LLM all honour these. Use them
# when the machine cannot reach those APIs directly. Both values are optional;
# the config.toml [proxy] block sets the same thing.
HTTP_PROXY=
HTTPS_PROXY=
# Hosts that must bypass the proxy (comma separated), e.g. a local LLM gateway:
# NO_PROXY=192.168.0.188,localhost,127.0.0.1

# =============================================================================
# Historical archive (biography) — NO API KEYS REQUIRED
# -----------------------------------------------------------------------------
# Phase 2 of the fork fetches real historical photographs of the subject from:
#   a. Wikimedia Commons  https://commons.wikimedia.org/w/api.php
#   b. Wikipedia REST     https://{lang}.wikipedia.org/api/rest_v1/page/summary
#   c. Library of Congress https://www.loc.gov/photos/?fo=json
# All three are public and key-less. Licensing is enforced in code: only
# public-domain / CC0 / CC BY images are used (CC BY-SA and NC are rejected
# because the video is published commercially).
#
# Wikimedia requires a descriptive User-Agent; set your own contact info here
# so your requests are identifiable (recommended by the API etiquette guide).
# https://meta.wikimedia.org/wiki/User-Agent_policy
WIKIMEDIA_USER_AGENT=

# =============================================================================
# Local biography corpus (built by scripts/library/*)
# =============================================================================
# Point at an alternative library.sqlite if you built the index elsewhere.
MPT_LIBRARY_DB=

# =============================================================================
# TTS (MVP uses the built-in Edge TTS, which needs no key)
# =============================================================================
# CosyVoice2 / custom cloned voice is planned behind a tts_provider adapter.
DASHSCOPE_API_KEY=
