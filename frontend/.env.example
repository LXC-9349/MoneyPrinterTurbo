# 前端 → FastAPI 后端地址（本地开发默认）
# PUBLIC_API_BASE：浏览器直连（写 / 轮询）。
PUBLIC_API_BASE=http://127.0.0.1:8080
# API_INTERNAL_BASE：SolidStart 服务端读代理（server$）访问后端，仅服务端可见，无 CORS。
API_INTERNAL_BASE=http://127.0.0.1:8080

# 开发期 CORS 注入（浏览器直连写/轮询用；前端 dev 源固定 http://localhost:3000）：
#   PowerShell:  $env:CORS_ALLOWED_ORIGINS="http://localhost:3000"; python main.py
#   bash/zsh:    CORS_ALLOWED_ORIGINS=http://localhost:3000 python main.py
# app/asgi.py 的 parse_cors_allowed_origins 已支持该环境变量，无需改后端代码。
